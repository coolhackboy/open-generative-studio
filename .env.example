# White-label settings. Copy to `.env.local` and edit. All values are optional.

# Name shown in the top bar, page title and Open Graph tags.
VITE_BRAND_NAME="Open Generative Studio"

# Absolute or /public-relative URL of a square logo (SVG/PNG). Defaults to the built-in mark.
VITE_BRAND_LOGO_URL=

# Accent color (any CSS color). Defaults to the PoYo lime.
VITE_ACCENT=

# API base URL. Point this at your own PoYo-compatible gateway if you resell.
VITE_API_BASE=https://api.poyo.ai

# Show the small "Powered by PoYo" link. Set to false to hide it.
VITE_SHOW_POWERED_BY=true
